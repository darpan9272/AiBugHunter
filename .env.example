# ─────────────────────────────────────────────
# Bug Hunting System — Environment Variables
# Copy this to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# Database
POSTGRES_PASSWORD=changeme_in_prod

# Vector Store
CHROMA_AUTH_TOKEN=iamthedrockxboy

# AI Models
GOOGLE_API_KEY=your_google_api_key_here              # Gemini 3 Pro (recon orchestrator, meta-agent)
ANTHROPIC_API_KEY=your_anthropic_api_key_here           # Claude Opus / Sonnet (triage, reports)

# Recon Tools
SHODAN_API_KEY=your_shodan_api_key_here
CENSYS_API_ID=your_censys_api_id_here
CENSYS_API_SECRET=your_censys_api_secret_here

# OOB Detection (for SSRF/blind injection detection)
INTERACTSH_SERVER=oast.pro
INTERACTSH_TOKEN=

# CVE / NVD lookups
NVD_API_KEY=your_nvd_api_key_here

# Alerting
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK/URL

# ─────────────────────────────────────────────
# ASM Platform — Extended Enrichment APIs
# ─────────────────────────────────────────────
# Censys (internet-wide asset intelligence)
CENSYS_API_ID=your_censys_api_id_here
CENSYS_API_SECRET=your_censys_api_secret_here

# Fofa (Chinese cyberspace search engine)
FOFA_EMAIL=your_fofa_email_here
FOFA_KEY=your_fofa_key_here

# BinaryEdge (internet scanning platform)
BINARYEDGE_API_KEY=your_binaryedge_api_key_here

# ZoomEye (Chinese cyberspace mapping)
ZOOMEYE_API_KEY=your_zoomeye_api_key_here

# GitHub (code search for secrets/exposure)
GITHUB_TOKEN=your_github_token_here

# ─────────────────────────────────────────────
# ASM Platform — Cloud Provider Credentials
# ─────────────────────────────────────────────
# AWS
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# Azure
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
AZURE_TENANT_ID=your_azure_tenant_id

# GCP
GCP_PROJECT_ID=your_gcp_project_id
GCP_SERVICE_ACCOUNT_KEY=path/to/service-account.json

# ─────────────────────────────────────────────
# ASM Platform — Alert Channels
# ─────────────────────────────────────────────
# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASS=your_smtp_password

# PagerDuty
PAGERDUTY_API_KEY=your_pagerduty_api_key

# OpsGenie
OPSGENIE_API_KEY=your_opsgenie_api_key

# Microsoft Teams
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/YOUR/WEBHOOK/URL

# Rate limiting (requests per second per tool)
RATE_LIMIT_RPS=5

# Target scope (comma-separated programme names to auto-load)
ACTIVE_PROGRAMS=example_program

# ─────────────────────────────────────────────
# Self-Learning Meta-Agent (optional, any provider)
# Point the learning engine at ANY OpenAI-compatible model
# (DeepSeek, Ollama, LM Studio, vLLM…) or leave unset to use Anthropic.
# ─────────────────────────────────────────────
LEARNING_BASE_URL=
LEARNING_API_KEY=
LEARNING_MODEL=
