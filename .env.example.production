# ─────────────────────────────────────────────
# Bug Hunting System — Production Environment Template
# For FREE/TIER-0 usage: Leave paid API keys empty to use free alternatives
# For ENHANCED usage: Add keys where available for better results
# ─────────────────────────────────────────────

# =============================================
# DATABASE (REQUIRED - no free alternative)
# =============================================
POSTGRES_PASSWORD=your_secure_password_here  # Change this in production!

# =============================================
# VECTOR STORE (REQUIRED for operation)
# =============================================
CHROMA_AUTH_TOKEN=changeme_in_prod_please  # Change this!

# =============================================
# AI MODELS - OPTIONAL FREE TIERS AVAILABLE
# =============================================
# For completely free operation, you can use local LLMs instead
# Set USE_LOCAL_LLM=true and configure LOCAL_LLM_URL below

# Google Gemini (Free tier available with limits)
GOOGLE_API_KEY=  # Get free key at https://makersuite.google.com/app/apikey

# Anthropic Claude (Free trial credits available)
ANTHROPIC_API_KEY=  # Get free trial at https://console.anthropic.com/

# OR use local LLM (completely free after setup)
USE_LOCAL_LLM=false  # Set to "true" to use local LLM instead of APIs
LOCAL_LLM_URL=http://localhost:11434  # Default Ollama URL
LOCAL_LLM_MODEL=llama3.1:8b  # Recommended model for reasoning

# =============================================
# RECONNAISSANCE - FREE ALTERNATIVES AVAILABLE
# =============================================
# Shodan (Free tier: 50 queries/month)
SHODAN_API_KEY=  # Get at https://account.shodan.io/

# Censys (Free tier: limited credits)
CENSYS_API_ID=  # Get at https://censys.io/
CENSYS_API_SECRET=

# VirusTotal (Free tier: 500 requests/day)
VIRUSTOTAL_API_KEY=  # Get at https://www.virustotal.com/gui/user/<your_id>/apikey

# SecurityTrails (Free tier: 50 queries/month)
SECURITYTRAILS_API_KEY=  # Get at https://securitytrails.com/

# =============================================
# VULNERABILITY INTELLIGENCE - FREE SOURCES
# =============================================
# NVD (Public API - no key needed but rate limited)
NVD_API_KEY=  # Optional: get at https://nvd.nist.gov/ for higher rate limits

# Vulners.com (Free tier available)
VULNERS_API_KEY=  # Get at https://vulners.com/api

# Exploit-DB (Free - no API needed for basic usage)
# PacketStorm (Free - no API needed for basic usage)

# =============================================
# OUT-OF-BAND DETECTION - FREE OPTIONS
# =============================================
# Interactsh (Self-hosted free option)
INTERACTSH_SERVER=oast.pro  # Public free server
INTERACTSH_TOKEN=  # Optional: for private server

# OR self-host your own (completely free):
# INTERACTSH_SERVER=your-interactsh-domain.com
# INTERACTSH_TOKEN=your-generated-token

# =============================================
# ALERTING - FREE WEBHOOK OPTIONS
# =============================================
# Slack (Free workspace available)
SLACK_WEBHOOK_URL=  # Create at https://api.slack.com/messaging/webhooks

# Discord (Free)
DISCORD_WEBHOOK_URL=  # Create via Discord server settings

# =============================================
# RATE LIMITING & PERFORMANCE
# =============================================
# Requests per second per tool (adjust based on your API tiers)
RATE_LIMIT_RPS=5

# Target scope (comma-separated programme names to auto-load)
ACTIVE_PROGRAMS=example_program

# =============================================
# ADVANCED FREE ENHANCEMENTS (OPTIONAL)
# =============================================
# Enable additional free scanners (install via OS package manager)
ENABLE_NMAP=true
ENABLE_NUCLEI=true
ENABLE_HTTPX=true
ENABLE_SUBFINDER=true
ENABLE_KATANA=true
ENABLE_GAU=true
ENABLE_DALFOX=true
ENABLE_SQLMAP=true
ENABLE_FFUF=true
ENABLE_BANDIT=true      # Python SAST
ENABLE_SEMGREP=true     # Multi-language SAST
ENABLE_SAFETY=true      # Python dependency scanner
ENABLE_NPM_AUDIT=true   # JS dependency scanner
ENABLE_TRIVY=true       # Container scanner
ENABLE_CHECKOV=true     # IaC scanner
ENABLE_GITLEAKS=true    # Secret scanner

# =============================================
# SELF-LEARNING CONFIGURATION
# =============================================
# How often to run meta-agent learning cycle (in hours)
LEARNING_CYCLE_HOURS=24

# Minimum confidence for auto-improvements
MIN_LEARNING_CONFIDENCE=0.7

# Maximum strategy versions to keep
MAX_STRATEGY_VERSIONS=10
